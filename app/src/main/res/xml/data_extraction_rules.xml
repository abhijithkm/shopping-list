<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer policy. App data is excluded everywhere, matching
  android:allowBackup="false". Whether guest lists should survive a phone change is an open
  product decision (docs/IMPLEMENTATION_STATUS.md); auth tokens must stay excluded either way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
